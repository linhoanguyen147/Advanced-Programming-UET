<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
            <Label text="HỆ THỐNG ĐẤU GIÁ" textFill="WHITE">
                <font><Font name="System Bold" size="18.0" /></font>
            </Label>

            <Region HBox.hgrow="ALWAYS" /> <HBox fx:id="boxLogin" spacing="10.0" alignment="CENTER_LEFT">
            <TextField fx:id="txtUsername" promptText="Tên đăng nhập" prefWidth="120.0"/>
            <PasswordField fx:id="txtPassword" promptText="Mật khẩu" prefWidth="120.0"/>
            <Button fx:id="btnLogin" text="Đăng nhập" onAction="#handleLogin" />
            <Button fx:id="btnRegister" text="Đăng ký" onAction="#handleShowRegister" style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
        </HBox>

            <HBox fx:id="boxLoggedIn" spacing="10.0" alignment="CENTER_LEFT" visible="false" managed="false">
                <Label text="Xin chào," textFill="#bdc3c7" />
                <Label fx:id="lblUserName" text="[Tên của bạn]" textFill="#2ecc71">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Label fx:id="lblBalance" text="Số dư: $0.0" textFill="#f1c40f">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Button fx:id="btnCreateAuction" text="+ Đăng bán sản phẩm" onAction="#handleCreateAuction"
                        visible="false" managed="false" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
                <Button fx:id="btnLogout" text="Đăng xuất" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
            </HBox>

        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.4" BorderPane.alignment="CENTER">

            <VBox spacing="5.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
                <Label text="Danh sách Phiên đấu giá">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAuctionId" text="Mã Phiên" prefWidth="60.0" />
                        <TableColumn fx:id="colItemName" text="Tên Sản Phẩm" prefWidth="150.0" />
                        <TableColumn fx:id="colStatus" text="Trạng Thái" prefWidth="90.0" />
                    </columns>
                </TableView>
                <Button fx:id="btnRefresh" text="Làm mới danh sách" onAction="#handleRefreshAuctions" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                </padding>

                <Label text="Chi tiết Sản phẩm">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>

                <GridPane hgap="10.0" vgap="8.0">
                    <Label text="Tên món hàng:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="lblItemName" text="..." GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>

                    <Label text="Mô tả chi tiết:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="lblItemDesc" text="..." GridPane.columnIndex="1" GridPane.rowIndex="1" wrapText="true"/>

                    <Label text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblStartingPrice" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="2" textFill="#27ae60" />
                </GridPane>

                <Separator />

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Giá cao nhất hiện tại:" style="-fx-font-size: 14px;" />
                    <Label fx:id="lblHighestBid" text="0.0" textFill="#e74c3c" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <Label text="bởi" />
                    <Label fx:id="lblHighestBidder" text="[Chưa có ai]" style="-fx-font-weight: bold;" />
                </HBox>

                <Separator />

                <Label text="Lịch sử giao dịch (Realtime):" />
                <TextArea fx:id="txtRealtimeLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-font-family: monospace;" />

                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <Label text="Mức giá đề xuất ($):" />
                    <TextField fx:id="txtBidAmount" prefWidth="100.0" promptText="Nhập giá..." />
                    <Button fx:id="btnPlaceBid" text="ĐẶT GIÁ NGAY" onAction="#handlePlaceBid" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" disable="true" />
                </HBox>

            </VBox>
        </SplitPane>
    </center>
</BorderPane>